# -----------------------------
# Default
# -----------------------------

# Detect text files automatically and normalize them to LF in repository
* text=auto eol=lf


# -----------------------------
# Windows
# -----------------------------

# Windows command scripts
*.bat  text eol=crlf
*.cmd  text eol=crlf

# PowerShell works with LF, so no need to force CRLF
*.ps1  text eol=lf
*.psm1 text eol=lf
*.psd1 text eol=lf


# -----------------------------
# Shell / Unix
# -----------------------------

*.sh   text eol=lf
*.bash text eol=lf
*.zsh  text eol=lf
*.fish text eol=lf


# -----------------------------
# Configuration
# -----------------------------

*.json text eol=lf
*.jsonc text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.toml text eol=lf
*.ini  text eol=lf
*.conf text eol=lf
*.env  text eol=lf

*.xml  text eol=lf


# -----------------------------
# Source code
# -----------------------------

*.go   text eol=lf
*.rs   text eol=lf
*.py   text eol=lf

*.js   text eol=lf
*.jsx  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf

*.c    text eol=lf
